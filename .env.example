# Persistence
DATABASE_URL=consentmove.db

# HTTP
CORS_ORIGINS=*
LOG_LEVEL=INFO

# OAuth — DELEGATED ONLY. This project must never be configured to request
# an application-wide grant. There is intentionally no `OAUTH_APP_*` setting.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback
OAUTH_SCOPES=openid profile email offline_access Files.Read Files.ReadWrite

# Job behaviour
JOB_POLL_INTERVAL_SECONDS=1.0
AUDIT_EXPORT_PATH=audit.json
